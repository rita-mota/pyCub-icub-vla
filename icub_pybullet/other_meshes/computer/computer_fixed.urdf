<robot name="computer">
<link name="baseLink">
    <contact>
        <lateral_friction value="1.0"/>
        <rolling_friction value="0.0"/>
        <contact_cfm value="0.0"/>
        <contact_erp value="1.0"/>
    </contact>
    <inertial>
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        <mass value="0.2"/>
        <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
    <visual>
        <origin rpy="0.0 0.0 1.5708" xyz="0.0 0.0 0.0"/>
        <geometry>
            <mesh filename="computer_base.obj" scale="1.0 1.0 1.0"/>
        </geometry>
        <material name="gray">
            <color rgba="0.5 0.5 0.5 1.0"/>
        </material>
    </visual>
    <collision>
        <origin rpy="0.0 0.0 1.5708" xyz="0.0 0.0 0.0"/>
        <geometry>
            <mesh filename="meshes/fixed_urdf/collision/baseLink.obj"/>
        </geometry>
    </collision>
</link>
<link name="screenLink">
    <inertial>
        <mass value="0.0"/>
        <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
    </inertial>
    <visual>
        <origin rpy="0.0 0.0 1.5708" xyz="0.0 0.0 0.0"/>
        <geometry>
            <mesh filename="computer_screen.obj" scale="1.0 1.0 1.0"/>
        </geometry>
        <material name="blue">
            <color rgba="0.0 0.0 1.0 1.0"/>
        </material>
    </visual>
</link>
<joint name="base_to_screen" type="fixed">
    <parent link="baseLink"/>
    <child link="screenLink"/>
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
</joint>
</robot>